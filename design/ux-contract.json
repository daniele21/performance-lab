{
  "schema_version": 1,
  "contract_version": "0.5.0",
  "applicable": true,
  "design_source_of_truth": {
    "type": "in-repo",
    "location": "design/"
  },
  "experience_context": {
    "primary_users": [
      "local AI / LLM engineers",
      "model and performance evaluators",
      "developers choosing a model/runtime configuration for a workload and device"
    ],
    "primary_jobs": [
      "choose a use case and find the best evidence-backed model + quantization + configuration for this device",
      "manually test one served model/configuration against a representative scenario",
      "understand quality, runtime and resource evidence without conflating the dimensions",
      "compare compatible evidence and understand model/configuration trade-offs",
      "detect regressions against an explicit compatible baseline"
    ],
    "primary_surfaces": [
      "Overview",
      "Find best setup",
      "Test a model",
      "Campaign / Campaign Results",
      "Live Run",
      "Runs / Run Detail",
      "Compare",
      "Library / Settings"
    ]
  },
  "decision_model": {
    "user_outcome_first": true,
    "task_model_before_layout": true,
    "hierarchy_before_visual_polish": true,
    "states_before_motion": true,
    "motion_requires_purpose": true,
    "evidence_before_completion": true
  },
  "principles": {
    "user_task_model_over_internal_architecture": true,
    "progressive_disclosure": true,
    "sensible_defaults": true,
    "clear_primary_action_hierarchy": true,
    "platform_appropriate": true,
    "bounded_information_density": true,
    "actionable_error_recovery": true
  },
  "information_architecture": {
    "primary_navigation": [
      "Overview",
      "Find best setup",
      "Test a model",
      "Runs",
      "Compare"
    ],
    "secondary_navigation": {
      "Library": [
        "Test suites",
        "Datasets",
        "Baselines",
        "Regression policies"
      ],
      "Settings": [
        "Endpoints",
        "Devices / targets",
        "Advanced"
      ]
    },
    "primary_user_question": "Which model works best for my workload on this device, and with which configuration?",
    "journey_hierarchy": {
      "primary": "Find best setup: use case -> models -> configuration search -> campaign -> results",
      "direct_manual": "Test a model: model -> scenario -> test -> review -> run result"
    }
  },
  "automatic_campaign": {
    "status": "ux_integrated_engine_pending",
    "use_case_first": true,
    "use_case_mapping_owner": "Python application/evaluation contracts",
    "candidate_identity": [
      "model artifact",
      "quantization when known",
      "runtime/effective serving configuration when known",
      "generation configuration",
      "endpoint",
      "device/hardware identity"
    ],
    "same_base_model_different_quantization_is_distinct_candidate": true,
    "configuration_search": {
      "request_parameters": "eligible when supported by the adapter/runtime contract",
      "runtime_load_parameters": "eligible only when the serving runtime exposes an explicit mutable configuration lifecycle",
      "browser_must_not_guess_parameter_ranges": true,
      "search_depth_presets": [
        "quick",
        "standard",
        "thorough",
        "custom"
      ]
    },
    "campaign_model": {
      "campaign_groups_immutable_runs": true,
      "run_identity_remains_authoritative": true,
      "bounded_scheduling_and_cleanup_required": true,
      "progress_failure_cancellation_recovery_required": true
    },
    "result_contract": {
      "recommend_model_quantization_and_configuration": true,
      "recommendation_requires_comparable_evidence": true,
      "decision_policy_explicit_and_versioned": true,
      "quality_runtime_resources_remain_separate": true,
      "universal_opaque_score_forbidden": true,
      "alternatives_when_supported": [
        "highest quality",
        "fastest",
        "lowest resource usage"
      ]
    }
  },
  "progressive_disclosure": [
    "essential",
    "contextual",
    "advanced",
    "expert / diagnostics"
  ],
  "critical_states": [
    "loading",
    "empty",
    "error",
    "disabled",
    "offline",
    "partial-result",
    "not-comparable",
    "not-evaluated",
    "cancelled",
    "campaign-partial",
    "campaign-blocked"
  ],
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "keyboard_when_applicable": true,
    "focus_visibility_order": true,
    "assistive_semantics": true,
    "text_scaling_when_applicable": true,
    "no_color_only_critical_meaning": true,
    "reduced_motion_when_applicable": true
  },
  "adaptive_layout": {
    "applicable": true,
    "supported_contexts": [
      "desktop-compact: 1024-1279px",
      "desktop-standard: 1280-1599px",
      "desktop-wide: >=1600px"
    ]
  },
  "design_system": {
    "component_source": "frontend/src/components and frontend/src/design",
    "brand_tokens": "design/brand-kit.json",
    "reuse_existing_semantic_component_first": true,
    "canonical_primitives": [
      "AppShell",
      "Navigation",
      "PageHeader",
      "Button",
      "Field",
      "Select",
      "Toggle",
      "Tabs",
      "Disclosure",
      "Status",
      "Metric",
      "MetricGroup",
      "DataTable",
      "Progress",
      "CompatibilitySummary",
      "IdentityDiff",
      "EmptyState",
      "ErrorState",
      "Toast",
      "Dialog"
    ]
  },
  "motion": {
    "purpose_required": true,
    "supported_purposes": [
      "feedback",
      "continuity",
      "spatial_relationship",
      "state_transition",
      "progress",
      "attention",
      "hierarchy",
      "meaningful_completion"
    ],
    "frequent_interactions_are_restrained": true,
    "gesture_motion_tracks_input": true,
    "performance_over_decorative_complexity": true,
    "reduced_motion": true
  },
  "graphics": {
    "functional_before_decorative": true,
    "ui_understandable_without_decorative_imagery": true,
    "supported_roles": [
      "explanation",
      "orientation",
      "onboarding",
      "empty_state",
      "status",
      "meaningful_completion",
      "data_visualization",
      "brand"
    ]
  },
  "critical_journeys": [
    {
      "id": "J0",
      "name": "Choose use case -> select model candidates -> search configurations -> run campaign -> understand best-fit result",
      "e2e": "required_when_executable"
    },
    {
      "id": "J1",
      "name": "Connect a model -> test it manually -> understand the result",
      "e2e": "required"
    },
    {
      "id": "J2",
      "name": "Find tested-model evidence with workload and device context",
      "e2e": "recommended"
    },
    {
      "id": "J3",
      "name": "Compare two compatible runs -> understand trade-offs",
      "e2e": "required"
    },
    {
      "id": "J4",
      "name": "Attempt incompatible comparison -> understand why deltas are invalid",
      "e2e": "required"
    },
    {
      "id": "J5",
      "name": "Run fails -> understand cause -> retry successfully",
      "e2e": "required"
    },
    {
      "id": "J6",
      "name": "Cancel a run -> resources release -> next run succeeds",
      "e2e": "required"
    }
  ],
  "reference_views": [
    "design/reference/ux-reference-board.svg#overview",
    "design/reference/find-best-setup.svg",
    "design/reference/model-connection.svg",
    "design/reference/ux-reference-board.svg#test-a-model",
    "design/reference/ux-reference-board.svg#live-run",
    "design/reference/ux-reference-board.svg#run-detail",
    "design/reference/ux-reference-board.svg#compare",
    "design/reference/ux-reference-board.svg#recovery"
  ],
  "validation": {
    "accessibility_automation": "planned with browser UI: Playwright + accessibility assertions",
    "visual_regression": "planned for stable high-value reference surfaces after implementation",
    "manual_accessibility": "keyboard/focus/contrast review at compact, standard and wide desktop sizes",
    "usability_evidence": "representative-user review before reference-grade UI claim"
  },
  "evidence": {
    "bounded_ci_retention": true,
    "identity_with_source_build_environment": true,
    "zero_residue_after_ui_e2e": true
  }
}
