{
  "schema_version": 1,
  "contract_version": "0.3.0",
  "commands": {
    "setup": {
      "status": "required",
      "run": "python -m pip install \"pip==26.2.1\" && python -m pip install -c requirements/ci-constraints.txt -e \".[dev]\" && npm install --global npm@11.17.0 && npm --prefix frontend ci"
    },
    "doctor": { "status": "recommended", "run": "python scripts/doctor.py" },
    "dev": { "status": "recommended", "run": "npm --prefix frontend run dev" },
    "check": {
      "status": "required",
      "run": "python scripts/validate.py && npm --prefix frontend run check"
    },
    "test": {
      "status": "required",
      "run": "python -m pytest --ignore=tests/e2e && npm --prefix frontend run test"
    },
    "e2e": {
      "status": "recommended",
      "run": "python -m pytest tests/e2e -v --tb=short"
    },
    "build": { "status": "required", "run": "npm --prefix frontend run build" },
    "smoke": {
      "status": "optional",
      "run": "npm --prefix frontend run preview -- --host 127.0.0.1"
    },
    "package": { "status": "optional", "run": "n/a until REL-UI-001" },
    "stop": { "status": "optional", "run": "Ctrl-C the foreground Vite dev/preview process" },
    "clean": { "status": "required", "run": "python scripts/clean.py" }
  },
  "end_to_end": {
    "recommended_when_full_workflow_boundary_exists": true,
    "critical_journeys_prioritized": true,
    "lower_level_tests_remain_primary": true,
    "use_stack_native_tooling": true,
    "run_against_built_artifact_when_material": true,
    "failure_evidence_bounded": true,
    "zero_residue_required": true
  },
  "build_identity": {
    "implementation_status": "deferred-to-REL-UI-001",
    "unique_per_build": false,
    "source_revision_required": false,
    "dirty_state_required": false,
    "lineage_fields": ["project", "platform", "architecture", "channel", "variant"],
    "artifact_name_fields": ["product", "product_version", "build_id", "source_revision"]
  },
  "artifact_lifecycle": {
    "implementation_status": "deferred-to-REL-UI-001",
    "immutable_successful_artifacts": false,
    "promote_only_after_success": false,
    "manifest_required": false,
    "manifest_name": "build-manifest.json",
    "checksum_algorithm": "sha256",
    "local_keep_successful_per_lineage": 2,
    "ci_store": "github-actions-or-equivalent",
    "ci_retention_days": 7,
    "release_store": "github-releases-or-equivalent",
    "release_artifacts_immutable": false
  },
  "build_delta": {
    "implementation_status": "deferred-to-REL-UI-001",
    "required": false,
    "compare_to": "previous-successful-comparable-build",
    "output": "BUILD_CHANGELOG.md",
    "bundle_with_artifact": false,
    "dimensions": [
      "source",
      "dependencies",
      "toolchain",
      "configuration",
      "compatibility_migrations",
      "artifact_metrics",
      "validation"
    ]
  },
  "local_runtime": {
    "applicable": false,
    "bind_default": "loopback",
    "port_strategy": "fixed-during-UIF-001; collision-fails-fast",
    "foreground_default": true,
    "readiness_required": true,
    "graceful_shutdown_required": true,
    "verify_no_project_listener_after_stop": true
  },
  "ephemeral_resources": {
    "run_identity": true,
    "isolated_workspace": true,
    "cleanup_paths": [
      "success",
      "failure",
      "timeout",
      "cancellation",
      "interrupt",
      "partial-initialization"
    ],
    "stale_resource_recovery": true,
    "ownership_required_before_cleanup": true,
    "post_cleanup_verification": true
  }
}
