{
  "name": "performance-lab-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.18.x",
    "npm": "11.17.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pre-real": "playwright test --config playwright.pre-real.config.ts",
    "test:e2e:full-product": "playwright test --config playwright.full-product.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "24.13.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
